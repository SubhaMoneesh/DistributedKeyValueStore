\f1\b\fs36 \cf0 Step 3: Implement the storage engine (in isolation, no networking yet)\
\pard\pardeftab720\sa240\partightenfactor0

\f4\b0\fs26 \cf0 src/storage_engine.h
\f2\fs24 :\
\pard\pardeftab720\partightenfactor0

\f4\fs26 \cf0 #pragma once\
#include <string>\
#include <unordered_map>\
#include <shared_mutex>\
#include <optional>\
\
class StorageEngine \{\
public:\
    void Put(const std::string& key, const std::string& value);\
    std::optional<std::string> Get(const std::string& key) const;\
    bool Delete(const std::string& key);\
\
private:\
    mutable std::shared_mutex mutex_;\
    std::unordered_map<std::string, std::string> data_;\
\};\
\pard\pardeftab720\sa240\partightenfactor0
\cf0 src/storage_engine.cpp
\f2\fs24 :\
\pard\pardeftab720\partightenfactor0

\f4\fs26 \cf0 #include "storage_engine.h"\
\
void StorageEngine::Put(const std::string& key, const std::string& value) \{\
    std::unique_lock lock(mutex_);  // exclusive lock for writes\
    data_[key] = value;\
\}\
\
std::optional<std::string> StorageEngine::Get(const std::string& key) const \{\
    std::shared_lock lock(mutex_);  // shared lock \'97 multiple readers OK\
    auto it = data_.find(key);\
    if (it == data_.end()) return std::nullopt;\
    return it->second;\
\}\
\
bool StorageEngine::Delete(const std::string& key) \{\
    std::unique_lock lock(mutex_);\
    return data_.erase(key) > 0;\
\}\
\pard\pardeftab720\sa240\partightenfactor0

\f1\b\fs24 \cf0 Key concepts to understand here (don't just copy-paste blindly):
\f2\b0 \
\pard\tx220\tx720\pardeftab720\li720\fi-720\partightenfactor0
\ls3\ilvl0
\f4\fs26 \cf0 \kerning1\expnd0\expndtw0 {\listtext	\uc0\u8226 	}\expnd0\expndtw0\kerning0
std::shared_mutex
\f2\fs24  allows multiple concurrent readers OR one exclusive writer. This is the reader-writer lock pattern.\
\ls3\ilvl0
\f4\fs26 \kerning1\expnd0\expndtw0 {\listtext	\uc0\u8226 	}\expnd0\expndtw0\kerning0
shared_lock
\f2\fs24  (read) vs 
\f4\fs26 unique_lock
\f2\fs24  (write) \'97 get this backwards and you'll either get data races or terrible read concurrency.\
\pard\tx220\tx720\pardeftab720\li720\fi-720\partightenfactor0
\ls3\ilvl0\cf0 \kerning1\expnd0\expndtw0 {\listtext	\uc0\u8226 	}\expnd0\expndtw0\kerning0
Why 
\f4\fs26 mutable
\f2\fs24 ? Because 
\f4\fs26 Get()
\f2\fs24  is logically 
\f4\fs26 const
\f2\fs24  (doesn't change the map) but still needs to lock the mutex, which requires modifying it.\
\pard\pardeftab720\sa240\partightenfactor0

\f1\b \cf0 Write a standalone unit test for this BEFORE wiring up gRPC.
\f2\b0  Use plain 
\f4\fs26 assert()
\f2\fs24  or a simple test framework (Catch2 or GoogleTest \'97 gRPC already pulls in GoogleTest as a dependency, so it's free to use). Test:\
\pard\tx220\tx720\pardeftab720\li720\fi-720\partightenfactor0
\ls4\ilvl0\cf0 \kerning1\expnd0\expndtw0 {\listtext	\uc0\u8226 	}\expnd0\expndtw0\kerning0
Put then Get returns the value\
\ls4\ilvl0\kerning1\expnd0\expndtw0 {\listtext	\uc0\u8226 	}\expnd0\expndtw0\kerning0
Get on missing key returns nullopt\
\ls4\ilvl0\kerning1\expnd0\expndtw0 {\listtext	\uc0\u8226 	}\expnd0\expndtw0\kerning0
Delete removes it, second delete returns false\
\ls4\ilvl0\kerning1\expnd0\expndtw0 {\listtext	\uc0\u8226 	}\expnd0\expndtw0\kerning0
(Optional but valuable) spin up 10 threads hammering Put/Get on overlapping keys, run under 
\f4\fs26 ThreadSanitizer
\f2\fs24  (
\f4\fs26 -fsanitize=thread
\f2\fs24 ) to catch races\
\pard\pardeftab720\sa240\partightenfactor0
\cf0 This step matters because once you wire in networking, debugging concurrency bugs through gRPC becomes much harder. Isolate and verify the core logic first.\
\pard\pardeftab720\sa298\partightenfactor0

\f1\b\fs36 \cf0 Step 4: Implement the gRPC server, calling into StorageEngine\
\pard\pardeftab720\sa240\partightenfactor0

\f4\b0\fs26 \cf0 src/server.cpp
\f2\fs24  \'97 implement the generated 
\f4\fs26 KeyValueStore::Service
\f2\fs24  interface:\
\pard\pardeftab720\partightenfactor0

\f4\fs26 \cf0 #include <grpcpp/grpcpp.h>\
#include "kv.grpc.pb.h"\
#include "storage_engine.h"\
\
class KVServiceImpl final : public kvstore::KeyValueStore::Service \{\
public:\
    grpc::Status Put(grpc::ServerContext* context,\
                      const kvstore::PutRequest* request,\
                      kvstore::PutResponse* response) override \{\
        storage_.Put(request->key(), request->value());\
        response->set_success(true);\
        return grpc::Status::OK;\
    \}\
\
    grpc::Status Get(grpc::ServerContext* context,\
                      const kvstore::GetRequest* request,\
                      kvstore::GetResponse* response) override \{\
        auto val = storage_.Get(request->key());\
        if (val.has_value()) \{\
            response->set_found(true);\
            response->set_value(*val);\
        \} else \{\
            response->set_found(false);\
        \}\
        return grpc::Status::OK;\
    \}\
\
    grpc::Status Delete(grpc::ServerContext* context,\
                         const kvstore::DeleteRequest* request,\
                         kvstore::DeleteResponse* response) override \{\
        bool ok = storage_.Delete(request->key());\
        response->set_success(ok);\
        return grpc::Status::OK;\
    \}\
\
private:\
    StorageEngine storage_;\
\};\
\
void RunServer(const std::string& address) \{\
    KVServiceImpl service;\
    grpc::ServerBuilder builder;\
    builder.AddListeningPort(address, grpc::InsecureServerCredentials());\
    builder.RegisterService(&service);\
    auto server = builder.BuildAndStart();\
    std::cout << "Server listening on " << address << std::endl;\
    server->Wait();\
\}\
\
int main(int argc, char** argv) \{\
    std::string address = "0.0.0.0:50051";\
    if (argc > 1) address = argv[1];  // allow port override for multi-node later\
    RunServer(address);\
    return 0;\
\}\
\pard\pardeftab720\sa240\partightenfactor0

\f1\b\fs24 \cf0 Important note for the future
\f2\b0 : gRPC's sync server already runs each RPC on a worker thread from its internal thread pool \'97 meaning your 
\f4\fs26 StorageEngine
\f2\fs24  will genuinely be accessed concurrently from real network requests, not just simulated threads. This is exactly why Step 3's thread-safety work matters.\
\pard\pardeftab720\sa298\partightenfactor0

\f1\b\fs36 \cf0 Step 5: Write a simple client to test it\
\pard\pardeftab720\sa240\partightenfactor0

\f4\b0\fs26 \cf0 src/client.cpp
\f2\fs24 :\
\pard\pardeftab720\partightenfactor0

\f4\fs26 \cf0 #include <grpcpp/grpcpp.h>\
#include "kv.grpc.pb.h"\
#include <iostream>\
\
int main(int argc, char** argv) \{\
    std::string target = "localhost:50051";\
    auto channel = grpc::CreateChannel(target, grpc::InsecureChannelCredentials());\
    auto stub = kvstore::KeyValueStore::NewStub(channel);\
\
    // PUT\
    \{\
        kvstore::PutRequest req;\
        req.set_key("foo");\
        req.set_value("bar");\
        kvstore::PutResponse resp;\
        grpc::ClientContext ctx;\
        auto status = stub->Put(&ctx, req, &resp);\
        std::cout << "Put success=" << resp.success() << std::endl;\
    \}\
\
    // GET\
    \{\
        kvstore::GetRequest req;\
        req.set_key("foo");\
        kvstore::GetResponse resp;\
        grpc::ClientContext ctx;\
        auto status = stub->Get(&ctx, req, &resp);\
        if (resp.found())\
            std::cout << "Got: " << resp.value() << std::endl;\
        else\
            std::cout << "Key not found" << std::endl;\
    \}\
\
    return 0;\
\}\
\pard\pardeftab720\sa240\partightenfactor0

