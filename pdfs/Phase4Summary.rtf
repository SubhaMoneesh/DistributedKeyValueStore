\f1\fs24  happens afterward, safely.\
Now the RPC handlers:\
\pard\pardeftab720\partightenfactor0

\f3\fs26 \cf0 grpc::Status Gossip(grpc::ServerContext*, const kvstore::GossipRequest* request,\
                     kvstore::GossipResponse* response) override \{\
    std::vector<GossipEntry> incoming;\
    for (const auto& e : request->entries())\
        incoming.push_back(\{e.node_address(), e.start_epoch_ms(), e.heartbeat()\});\
    membership_.MergeRemote(incoming);\
\
    for (const auto& e : membership_.GetSnapshotForGossip()) \{\
        auto* out = response->add_entries();\
        out->set_node_address(e.address);\
        out->set_start_epoch_ms(e.start_epoch_ms);\
        out->set_heartbeat(e.heartbeat);\
    \}\
    return grpc::Status::OK;\
\}\
\
grpc::Status DebugMembership(grpc::ServerContext*, const kvstore::DebugMembershipRequest*,\
                              kvstore::DebugMembershipResponse* response) override \{\
    for (const auto& e : membership_.DebugSnapshot()) \{\
        auto* out = response->add_entries();\
        out->set_node_address(e.address);\
        out->set_status(ToString(e.status));\
        out->set_heartbeat(e.heartbeat);\
        out->set_start_epoch_ms(e.start_epoch_ms);\
    \}\
    return grpc::Status::OK;\
\}\
\pard\pardeftab720\sa240\partightenfactor0

\f1\fs24 \cf0 The gossip loop and its helpers (public, since it's launched from a 
\f3\fs26 std::thread
\f1\fs24  outside the class):\
\pard\pardeftab720\partightenfactor0

\f3\fs26 \cf0 void GossipLoop() \{\
    std::mt19937 rng(std::random_device\{\}());\
    while (!shutdown_requested.load()) \{\
        membership_.IncrementSelfHeartbeat();\
        membership_.CheckTimeouts();\
\
        for (const auto& target : PickGossipTargets(rng, kGossipFanout))\
            SendGossip(target);\
\
        std::this_thread::sleep_for(kGossipInterval);\
    \}\
\}\
\
private:\
std::vector<std::string> PickGossipTargets(std::mt19937& rng, int fanout) \{\
    std::vector<std::string> candidates;\
    for (auto& addr : all_nodes_)\
        if (addr != self_address_) candidates.push_back(addr);\
    std::shuffle(candidates.begin(), candidates.end(), rng);\
    if (static_cast<int>(candidates.size()) > fanout) candidates.resize(fanout);\
    return candidates;\
\}\
\
void SendGossip(const std::string& target) \{\
    kvstore::GossipRequest req;\
    for (const auto& e : membership_.GetSnapshotForGossip()) \{\
        auto* out = req.add_entries();\
        out->set_node_address(e.address);\
        out->set_start_epoch_ms(e.start_epoch_ms);\
        out->set_heartbeat(e.heartbeat);\
    \}\
    kvstore::GossipResponse resp;\
    grpc::ClientContext ctx;\
    ctx.set_deadline(std::chrono::system_clock::now() + std::chrono::milliseconds(500));\
    auto status = peer_stubs_.at(target)->Gossip(&ctx, req, &resp);\
    if (!status.ok()) return; // unreachable target -- silence will eventually mark it dead\
\
    std::vector<GossipEntry> incoming;\
    for (const auto& e : resp.entries())\
        incoming.push_back(\{e.node_address(), e.start_epoch_ms(), e.heartbeat()\});\
    membership_.MergeRemote(incoming); // push-pull: also merge what they sent back\
\}\
\pard\pardeftab720\sa240\partightenfactor0

