\f3\fs26 \cf0 #include "../src/membership_service.h"\
#include <iostream>\
#include <cassert>\
#include <thread>\
#include <chrono>\
#include <algorithm>\
\
NodeStatus StatusOf(const MembershipService& m, const std::string& addr) \{\
    for (auto& e : m.DebugSnapshot())\
        if (e.address == addr) return e.status;\
    assert(false && "address not found");\
    return NodeStatus::DEAD;\
\}\
\
void test_initial_grace_period() \{\
    MembershipService m("nodeA", \{"nodeA", "nodeB", "nodeC"\});\
    assert(StatusOf(m, "nodeB") == NodeStatus::ALIVE);\
    assert(StatusOf(m, "nodeC") == NodeStatus::ALIVE);\
    std::cout << "[OK] All peers start as ALIVE during the initial grace period.\\n";\
\}\
\
void test_self_heartbeat_increments() \{\
    MembershipService m("nodeA", \{"nodeA", "nodeB"\});\
    m.IncrementSelfHeartbeat();\
    m.IncrementSelfHeartbeat();\
    for (auto& e : m.DebugSnapshot())\
        if (e.address == "nodeA") assert(e.heartbeat == 2);\
    std::cout << "[OK] Self heartbeat counter increments correctly.\\n";\
\}\
\
void test_merge_prefers_higher_heartbeat() \{\
    MembershipService m("nodeA", \{"nodeA", "nodeB"\});\
    m.MergeRemote(\{\{"nodeB", 1000, 5\}\});\
    m.MergeRemote(\{\{"nodeB", 1000, 2\}\});  // stale, same epoch -> must be ignored\
    for (auto& e : m.DebugSnapshot())\
        if (e.address == "nodeB") assert(e.heartbeat == 5);\
    m.MergeRemote(\{\{"nodeB", 1000, 9\}\});  // fresher, same epoch -> must be accepted\
    for (auto& e : m.DebugSnapshot())\
        if (e.address == "nodeB") assert(e.heartbeat == 9);\
    std::cout << "[OK] Merge correctly ignores stale heartbeats and accepts fresher ones.\\n";\
\}\
\
void test_merge_prefers_higher_epoch_even_with_lower_heartbeat() \{\
    MembershipService m("nodeA", \{"nodeA", "nodeB"\});\
    m.MergeRemote(\{\{"nodeB", 1000, 500\}\});  // nodeB has been up a while\
    m.MergeRemote(\{\{"nodeB", 2000, 0\}\});    // nodeB restarted: new epoch, counter reset\
    for (auto& e : m.DebugSnapshot()) \{\
        if (e.address == "nodeB") \{\
            assert(e.heartbeat == 0);\
            assert(e.status == NodeStatus::ALIVE);\
        \}\
    \}\
    std::cout << "[OK] A higher start_epoch (restart) always wins, even with a lower heartbeat.\\n";\
\}\
\
void test_timeout_transitions() \{\
    using namespace std::chrono_literals;\
    MembershipService m("nodeA", \{"nodeA", "nodeB"\}, 100ms, 300ms);\
    m.MergeRemote(\{\{"nodeB", 1, 1\}\});\
    assert(StatusOf(m, "nodeB") == NodeStatus::ALIVE);\
    std::this_thread::sleep_for(150ms);\
    m.CheckTimeouts();\
    assert(StatusOf(m, "nodeB") == NodeStatus::SUSPECT);\
    std::this_thread::sleep_for(200ms);\
    m.CheckTimeouts();\
    assert(StatusOf(m, "nodeB") == NodeStatus::DEAD);\
    m.MergeRemote(\{\{"nodeB", 1, 2\}\});   // fresh news resurrects it\
    assert(StatusOf(m, "nodeB") == NodeStatus::ALIVE);\
    std::cout << "[OK] ALIVE -> SUSPECT -> DEAD -> ALIVE transitions work correctly.\\n";\
\}\
\
void test_get_alive_nodes() \{\
    using namespace std::chrono_literals;\
    MembershipService m("nodeA", \{"nodeA", "nodeB", "nodeC"\}, 100ms, 300ms);\
    m.MergeRemote(\{\{"nodeB", 1, 1\}, \{"nodeC", 1, 1\}\});\
    std::this_thread::sleep_for(350ms);\
    m.CheckTimeouts();\
    auto alive = m.GetAliveNodes();\
    assert(std::find(alive.begin(), alive.end(), "nodeA") != alive.end());\
    assert(std::find(alive.begin(), alive.end(), "nodeB") == alive.end());\
    std::cout << "[OK] GetAliveNodes correctly filters out dead peers.\\n";\
\}\
\
int main() \{\
    std::cout << "----------------------------------------------------------\\n";\
    std::cout << "        RUNNING MEMBERSHIP SERVICE ISOLATION TESTS        \\n";\
    std::cout << "----------------------------------------------------------\\n";\
    test_initial_grace_period();\
    test_self_heartbeat_increments();\
    test_merge_prefers_higher_heartbeat();\
    test_merge_prefers_higher_epoch_even_with_lower_heartbeat();\
    test_timeout_transitions();\
    test_get_alive_nodes();\
    std::cout << "----------------------------------------------------------\\n";\
    std::cout << "          ALL VERIFICATIONS PASSED SUCCESSFULLY!          \\n";\
    std::cout << "----------------------------------------------------------\\n";\
    return 0;\
\}\
