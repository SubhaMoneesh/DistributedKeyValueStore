\
std::vector<std::string> ReadAddresses(const std::string& path) \{\
    std::vector<std::string> addrs;\
    std::ifstream file(path);\
    std::string line;\
    while (std::getline(file, line)) if (!line.empty()) addrs.push_back(line);\
    return addrs;\
\}\
\
std::string PortOf(const std::string& address) \{ return address.substr(address.find(':') + 1); \}\
\
void KillNode(const std::string& address) \{\
    std::system(("./scripts/kill_node.sh " + PortOf(address)).c_str());\
\}\
void RestartNode(const std::string& address) \{\
    std::system(("./scripts/restart_node.sh " + PortOf(address)).c_str());\
\}\
\
std::string StatusOf(kvstore::KeyValueStore::Stub* stub, const std::string& target) \{\
    kvstore::DebugMembershipRequest req;\
    kvstore::DebugMembershipResponse resp;\
    grpc::ClientContext ctx;\
    auto status = stub->DebugMembership(&ctx, req, &resp);\
    assert(status.ok());\
    for (const auto& e : resp.entries())\
        if (e.node_address() == target) return e.status();\
    return "UNKNOWN";\
\}\
\
int main() \{\
    auto addresses = ReadAddresses("cluster.conf");\
    std::vector<std::unique_ptr<kvstore::KeyValueStore::Stub>> stubs;\
    for (auto& a : addresses)\
        stubs.push_back(kvstore::KeyValueStore::NewStub(\
            grpc::CreateChannel(a, grpc::InsecureChannelCredentials())));\
\
    std::cout << "Waiting 2s for initial gossip convergence..." << std::endl;\
    std::this_thread::sleep_for(std::chrono::seconds(2));\
\
    for (size_t i = 0; i < stubs.size(); i++)\
        for (auto& target : addresses)\
            assert(StatusOf(stubs[i].get(), target) == "ALIVE");\
    std::cout << "[OK] Baseline: all nodes see all nodes as ALIVE." << std::endl;\
\
    std::string victim = addresses[0];\
    KillNode(victim);\
    std::cout << "Killed " << victim << ". Waiting for dead_timeout to elapse..." << std::endl;\
    std::this_thread::sleep_for(std::chrono::milliseconds(6000));\
\
    for (size_t i = 1; i < stubs.size(); i++)\
        assert(StatusOf(stubs[i].get(), victim) == "DEAD");\
    std::cout << "[OK] All survivors independently marked " << victim << " as DEAD." << std::endl;\
\
    \{\
        kvstore::PutRequest req; req.set_key("gossip_test_key"); req.set_value("still_works");\
        kvstore::PutResponse resp;\
        grpc::ClientContext ctx;\
        auto status = stubs[1]->Put(&ctx, req, &resp);\
        assert(status.ok() && resp.success());\
    \}\
    std::cout << "[OK] Quorum writes still succeed while one node is dead." << std::endl;\
\
    RestartNode(victim);\
    std::cout << "Restarted " << victim << ". Waiting for rejoin gossip..." << std::endl;\
    std::this_thread::sleep_for(std::chrono::milliseconds(2000));\
\
    for (size_t i = 0; i < stubs.size(); i++)\
        assert(StatusOf(stubs[i].get(), victim) == "ALIVE");\
    std::cout << "[OK] All nodes correctly see " << victim << " as ALIVE again after restart." << std::endl;\
\
    std::cout << "\\nGossip failure-detection and recovery test PASSED." << std::endl;\
    return 0;\
\}\
