\f3\fs26 \cf0 for (auto& node: pref) \{\
    if (node == self_address_) \{\
        storage_.Put(request->key(), request->value(), timestamp);\
        ack++;\
        continue;\
    \}\
    if (membership_.IsDead(node)) \{\
        // Known-dead peer: don't burn up to 2 seconds waiting on a doomed RPC.\
        // Not acking here has exactly the same effect on the quorum count as\
        // attempting the call and having it time out -- we just find out faster.\
        continue;\
    \}\
    futures.push_back(std::async(std::launch::async, [\
        this, node, key = request->key(), value = request->value(), timestamp\
    ] () \{\
        return SendReplicatePut(node, key, value, timestamp);\
    \}));\
\}\
