\f5\fs26 \cf0 #pragma once\
#include <cstdint>\
#include <map>\
#include <string>\
#include <vector>\
#include <shared_mutex>\
\
class ConsistentHashRing \{\
public:\
    explicit ConsistentHashRing(int virtual_nodes_per_physical = 150);\
\
    void AddNode(const std::string& node_address);\
    void RemoveNode(const std::string& node_address);\
\
    // Returns the physical node address that owns this key\
    std::string GetNode(const std::string& key) const;\
\
    std::vector<std::string> GetAllPhysicalNodes() const;\
\
    static uint64_t Hash(const std::string& input);\
\
private:\
    int virtual_nodes_per_physical_;\
    std::map<uint64_t, std::string> ring_;   // hash -> physical node address\
    mutable std::shared_mutex mutex_;\
\};\
\pard\pardeftab720\sa240\partightenfactor0

\f4\b \cf0 src/hash_ring.cpp
\f1\fs24 :
\f2\b0 \
\pard\pardeftab720\partightenfactor0

\f5\fs26 \cf0 #include "hash_ring.h"\
#include <set>\
\
uint64_t ConsistentHashRing::Hash(const std::string& input) \{\
    // FNV-1a 64-bit \'97 simple, dependency-free, deterministic across machines.\
    uint64_t hash = 14695981039346656037ULL;   // FNV offset basis\
    for (unsigned char c : input) \{\
        hash ^= c;\
        hash *= 1099511628211ULL;              // FNV prime\
    \}\
    return hash;\
\}\
\
ConsistentHashRing::ConsistentHashRing(int virtual_nodes_per_physical)\
    : virtual_nodes_per_physical_(virtual_nodes_per_physical) \{\}\
\
void ConsistentHashRing::AddNode(const std::string& node_address) \{\
    std::unique_lock lock(mutex_);\
    for (int i = 0; i < virtual_nodes_per_physical_; i++) \{\
        std::string vnode_key = node_address + "#" + std::to_string(i);\
        ring_[Hash(vnode_key)] = node_address;\
    \}\
\}\
\
void ConsistentHashRing::RemoveNode(const std::string& node_address) \{\
    std::unique_lock lock(mutex_);\
    for (int i = 0; i < virtual_nodes_per_physical_; i++) \{\
        std::string vnode_key = node_address + "#" + std::to_string(i);\
        ring_.erase(Hash(vnode_key));\
    \}\
\}\
\
std::string ConsistentHashRing::GetNode(const std::string& key) const \{\
    std::shared_lock lock(mutex_);\
    if (ring_.empty()) return "";\
    uint64_t h = Hash(key);\
    auto it = ring_.lower_bound(h);\
    if (it == ring_.end()) \{\
        it = ring_.begin();   // wrap around the ring\
    \}\
    return it->second;\
\}\
\
std::vector<std::string> ConsistentHashRing::GetAllPhysicalNodes() const \{\
    std::shared_lock lock(mutex_);\
    std::set<std::string> unique_nodes;\
    for (auto& [hash, addr] : ring_) unique_nodes.insert(addr);\
    return std::vector<std::string>(unique_nodes.begin(), unique_nodes.end());\
\}\
\pard\pardeftab720\sa240\partightenfactor0

\f1\b\fs24 \cf0 Key thing to understand:
\f2\b0  
\f5\fs26 ring_
\f2\fs24  is a 
\f5\fs26 std::map
\f2\fs24 , which is always kept sorted by key (the hash). 
\f5\fs26 lower_bound(h)
\f2\fs24  finds the first entry with hash \uc0\u8805  h in O(log n) \'97 that's "walking clockwise" on the ring. Because insertion is keyed by hash value (not by insertion order), 
\f1\b every node builds the exact same ring
\f2\b0  regardless of the order addresses appear in the config file. That's crucial for correctness.\
\pard\pardeftab720\partightenfactor0
