\f5\fs26 \cf0 #include "../src/hash_ring.h"\
#include <iostream>\
#include <cassert>\
#include <unordered_map>\
#include <random>\
\
void test_determinism() \{\
    ConsistentHashRing ring;\
    for (int i = 1; i <= 6; i++)\
        ring.AddNode("node" + std::to_string(i));\
\
    std::string owner1 = ring.GetNode("some_key");\
    std::string owner2 = ring.GetNode("some_key");\
    assert(owner1 == owner2);\
    std::cout << "[OK] Determinism: same key always maps to same node.\\n";\
\}\
\
void test_distribution() \{\
    ConsistentHashRing ring;\
    for (int i = 1; i <= 6; i++)\
        ring.AddNode("node" + std::to_string(i));\
\
    std::unordered_map<std::string, int> counts;\
    int total_keys = 100000;\
    for (int i = 0; i < total_keys; i++)\
        counts[ring.GetNode("key_" + std::to_string(i))]++;\
\
    std::cout << "Distribution across 6 nodes:\\n";\
    double expected = total_keys / 6.0;\
    for (auto& [node, count] : counts) \{\
        double ratio = count / expected;\
        std::cout << "  " << node << ": " << count\
                  << " (" << ratio << "x expected)\\n";\
        assert(ratio > 0.7 && ratio < 1.3);  // reasonably even with vnodes\
    \}\
    std::cout << "[OK] Distribution: reasonably even across nodes.\\n";\
\}\
\
void test_minimal_disruption() \{\
    ConsistentHashRing ring;\
    for (int i = 1; i <= 6; i++)\
        ring.AddNode("node" + std::to_string(i));\
\
    int total_keys = 10000;\
    std::unordered_map<std::string, std::string> before;\
    for (int i = 0; i < total_keys; i++) \{\
        std::string key = "key_" + std::to_string(i);\
        before[key] = ring.GetNode(key);\
    \}\
\
    ring.RemoveNode("node3");   // simulate a node leaving\
\
    int moved = 0;\
    for (int i = 0; i < total_keys; i++) \{\
        std::string key = "key_" + std::to_string(i);\
        if (ring.GetNode(key) != before[key]) moved++;\
    \}\
\
    double moved_ratio = (double)moved / total_keys;\
    std::cout << "Removed 1 of 6 nodes: " << moved\
              << " / " << total_keys << " keys moved ("\
              << (moved_ratio * 100) << "%)\\n";\
    // Should be roughly 1/6 (~16.7%), NOT anywhere near 100%\
    assert(moved_ratio < 0.30);\
    std::cout << "[OK] Minimal disruption: removing a node only remaps ~1/N of keys.\\n";\
\}\
\
int main() \{\
    test_determinism();\
    test_distribution();\
    test_minimal_disruption();\
    std::cout << "All hash ring tests passed.\\n";\
    return 0;\
\}\
