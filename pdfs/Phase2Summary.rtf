\f5\fs26 \cf0 #include "kv.grpc.pb.h"\
#include <grpcpp/grpcpp.h>\
#include <iostream>\
#include <fstream>\
#include <vector>\
#include <random>\
#include <cassert>\
\
int main() \{\
    std::vector<std::string> addresses;\
    std::ifstream file("cluster.conf");\
    std::string line;\
    while (std::getline(file, line)) if (!line.empty()) addresses.push_back(line);\
\
    std::vector<std::unique_ptr<kvstore::KeyValueStore::Stub>> stubs;\
    for (auto& addr : addresses) \{\
        auto channel = grpc::CreateChannel(addr, grpc::InsecureChannelCredentials());\
        stubs.push_back(kvstore::KeyValueStore::NewStub(channel));\
    \}\
\
    std::mt19937 rng(42);\
    std::uniform_int_distribution<int> node_pick(0, addresses.size() - 1);\
\
    // 1. Every node should agree on the owner of a given key\
    std::string owner_seen;\
    for (auto& stub : stubs) \{\
        kvstore::DebugOwnerRequest req; req.set_key("consistency_check_key");\
        kvstore::DebugOwnerResponse resp;\
        grpc::ClientContext ctx;\
        stub->DebugOwner(&ctx, req, &resp);\
        if (owner_seen.empty()) owner_seen = resp.owner_address();\
        assert(resp.owner_address() == owner_seen);\
    \}\
    std::cout << "[OK] All 6 nodes agree: owner of key = " << owner_seen << std::endl;\
\
    // 2. Write via a random node, read via a different random node\
    int num_keys = 200;\
    for (int i = 0; i < num_keys; i++) \{\
        std::string key = "key_" + std::to_string(i);\
        std::string value = "value_" + std::to_string(i);\
\
        \{\
            auto& stub = stubs[node_pick(rng)];\
            kvstore::PutRequest req; req.set_key(key); req.set_value(value);\
            kvstore::PutResponse resp;\
            grpc::ClientContext ctx;\
            auto status = stub->Put(&ctx, req, &resp);\
            assert(status.ok() && resp.success());\
        \}\
        \{\
            auto& stub = stubs[node_pick(rng)];   // possibly a DIFFERENT node\
            kvstore::GetRequest req; req.set_key(key);\
            kvstore::GetResponse resp;\
            grpc::ClientContext ctx;\
            auto status = stub->Get(&ctx, req, &resp);\
            assert(status.ok() && resp.found() && resp.value() == value);\
        \}\
    \}\
    std::cout << "[OK] " << num_keys\
              << " keys written/read via random entry nodes \'97 routing correct." << std::endl;\
    return 0;\
\}\
