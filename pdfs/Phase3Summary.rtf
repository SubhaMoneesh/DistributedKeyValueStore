\f5\b0\fs26 \cf0 syntax = "proto3";\
package kvstore;\
\
service KeyValueStore \{\
  // Client-facing API (unchanged shape \'97 clients don't know replication exists)\
  rpc Get(GetRequest) returns (GetResponse);\
  rpc Put(PutRequest) returns (PutResponse);\
  rpc Delete(DeleteRequest) returns (DeleteResponse);\
\
  // Internal, node-to-node replication RPCs\
  rpc ReplicatePut(ReplicatePutRequest) returns (ReplicatePutResponse);\
  rpc ReplicateGet(ReplicateGetRequest) returns (ReplicateGetResponse);\
  rpc ReplicateDelete(ReplicateDeleteRequest) returns (ReplicateDeleteResponse);\
\
  // Debug/testing only\
  rpc DebugOwner(DebugOwnerRequest) returns (DebugOwnerResponse);\
  rpc DebugPreferenceList(DebugPreferenceListRequest) returns (DebugPreferenceListResponse);\
  rpc DebugLocalGet(DebugLocalGetRequest) returns (DebugLocalGetResponse);\
\}\
\
message GetRequest \{ string key = 1; \}\
message GetResponse \{ bool found = 1; bytes value = 2; \}\
\
message PutRequest \{ string key = 1; bytes value = 2; \}\
message PutResponse \{ bool success = 1; \}\
\
message DeleteRequest \{ string key = 1; \}\
message DeleteResponse \{ bool success = 1; \}\
\
message ReplicatePutRequest \{ string key = 1; bytes value = 2; uint64 timestamp = 3; \}\
message ReplicatePutResponse \{ bool success = 1; \}\
\
message ReplicateGetRequest \{ string key = 1; \}\
message ReplicateGetResponse \{\
  bool found = 1;\
  bytes value = 2;\
  uint64 timestamp = 3;\
  bool is_tombstone = 4;\
\}\
\
message ReplicateDeleteRequest \{ string key = 1; uint64 timestamp = 2; \}\
message ReplicateDeleteResponse \{ bool success = 1; \}\
\
message DebugOwnerRequest \{ string key = 1; \}\
message DebugOwnerResponse \{ string owner_address = 1; \}\
\
message DebugPreferenceListRequest \{ string key = 1; \}\
message DebugPreferenceListResponse \{ repeated string nodes = 1; \}\
\
message DebugLocalGetRequest \{ string key = 1; \}\
message DebugLocalGetResponse \{\
  bool exists = 1;\
  bool is_tombstone = 2;\
  bytes value = 3;\
  uint64 timestamp = 4;\
\}\
