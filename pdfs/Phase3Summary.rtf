\f5\fs26 \cf0 #include <grpcpp/grpcpp.h>\
#include "storage_engine.h"\
#include "hash_ring.h"\
#include "kv.grpc.pb.h"\
#include <iostream>\
#include <fstream>\
#include <csignal>\
#include <atomic>\
#include <thread>\
#include <chrono>\
#include <future>\
\
std::unique_ptr<grpc::Server> server;\
std::atomic<bool> shutdown_requested(false);\
void SignalHandler(int signal) \{ shutdown_requested.store(true); \}\
\
uint64_t NowMicros() \{\
    return std::chrono::duration_cast<std::chrono::microseconds>(\
        std::chrono::system_clock::now().time_since_epoch()).count();\
\}\
\
class KVServiceImpl : public kvstore::KeyValueStore::Service \{\
public:\
    static constexpr int kN = 3;   // replication factor\
    static constexpr int kW = 2;   // write quorum\
    static constexpr int kR = 2;   // read quorum\
\
    KVServiceImpl(std::string self_address, const std::vector<std::string>& all_nodes)\
        : self_address_(std::move(self_address)) \{\
        for (const auto& addr : all_nodes) \{\
            ring_.AddNode(addr);\
            if (addr != self_address_) \{\
                auto channel = grpc::CreateChannel(addr, grpc::InsecureChannelCredentials());\
                peer_stubs_[addr] = kvstore::KeyValueStore::NewStub(channel);\
            \}\
        \}\
        std::cout << "Node " << self_address_ << " ready. N=" << kN\
                   << " W=" << kW << " R=" << kR << std::endl;\
    \}\
\
    // ---------- Client-facing API ----------\
\
    grpc::Status Put(grpc::ServerContext*, const kvstore::PutRequest* request,\
                      kvstore::PutResponse* response) override \{\
        std::string key = request->key();\
        std::string value = request->value();\
        uint64_t timestamp = NowMicros();\
        auto pref = ring_.GetPreferenceList(key, kN);\
\
        int acks = 0;\
        std::vector<std::future<bool>> futures;\
        for (const auto& node : pref) \{\
            if (node == self_address_) \{\
                storage_.Put(key, value, timestamp);\
                acks++;\
                continue;\
            \}\
            std::string node_copy = node;\
            futures.push_back(std::async(std::launch::async, [this, node_copy, key, value, timestamp]() \{\
                return SendReplicatePut(node_copy, key, value, timestamp);\
            \}));\
        \}\
        for (auto& f : futures) if (f.get()) acks++;\
\
        response->set_success(acks >= kW);\
        if (acks >= kW) return grpc::Status::OK;\
        return grpc::Status(grpc::StatusCode::UNAVAILABLE, "Failed to reach write quorum");\
    \}\
\
    grpc::Status Get(grpc::ServerContext*, const kvstore::GetRequest* request,\
                      kvstore::GetResponse* response) override \{\
        std::string key = request->key();\
        auto pref = ring_.GetPreferenceList(key, kN);\
\
        struct Reply \{ bool ok; bool found; std::string value; uint64_t timestamp; bool tombstone; \};\
        std::vector<Reply> replies;\
        std::vector<std::future<Reply>> futures;\
\
        for (const auto& node : pref) \{\
            if (node == self_address_) \{\
                auto v = storage_.GetVersioned(key);\
                if (v.has_value())\
                    replies.push_back(\{true, true, v->value, v->timestamp, v->is_tombstone\});\
                else\
                    replies.push_back(\{true, false, "", 0, false\});\
                continue;\
            \}\
            std::string node_copy = node;\
            futures.push_back(std::async(std::launch::async, [this, node_copy, key]() -> Reply \{\
                kvstore::ReplicateGetRequest req;\
                req.set_key(key);\
                kvstore::ReplicateGetResponse resp;\
                grpc::ClientContext ctx;\
                ctx.set_deadline(std::chrono::system_clock::now() + std::chrono::milliseconds(2000));\
                auto status = peer_stubs_.at(node_copy)->ReplicateGet(&ctx, req, &resp);\
                if (!status.ok()) return \{false, false, "", 0, false\};\
                return \{true, resp.found(), resp.value(), resp.timestamp(), resp.is_tombstone()\};\
            \}));\
        \}\
        for (auto& f : futures) replies.push_back(f.get());\
\
        int responded = 0;\
        bool have_winner = false;\
        Reply winner\{\};\
        for (auto& r : replies) \{\
            if (!r.ok) continue;\
            responded++;\
            if (r.found && (!have_winner || r.timestamp > winner.timestamp)) \{\
                winner = r;\
                have_winner = true;\
            \}\
        \}\
\
        if (responded < kR) \{\
            return grpc::Status(grpc::StatusCode::UNAVAILABLE, "Failed to reach read quorum");\
        \}\
        response->set_found(have_winner && !winner.tombstone);\
        if (response->found()) response->set_value(winner.value);\
        return grpc::Status::OK;\
    \}\
\
    grpc::Status Delete(grpc::ServerContext*, const kvstore::DeleteRequest* request,\
                         kvstore::DeleteResponse* response) override \{\
        std::string key = request->key();\
        uint64_t timestamp = NowMicros();\
        auto pref = ring_.GetPreferenceList(key, kN);\
\
        int acks = 0;\
        std::vector<std::future<bool>> futures;\
        for (const auto& node : pref) \{\
            if (node == self_address_) \{\
                storage_.Delete(key, timestamp);\
                acks++;\
                continue;\
            \}\
            std::string node_copy = node;\
            futures.push_back(std::async(std::launch::async, [this, node_copy, key, timestamp]() \{\
                kvstore::ReplicateDeleteRequest req;\
                req.set_key(key);\
                req.set_timestamp(timestamp);\
                kvstore::ReplicateDeleteResponse resp;\
                grpc::ClientContext ctx;\
                ctx.set_deadline(std::chrono::system_clock::now() + std::chrono::milliseconds(2000));\
                auto status = peer_stubs_.at(node_copy)->ReplicateDelete(&ctx, req, &resp);\
                return status.ok() && resp.success();\
            \}));\
        \}\
        for (auto& f : futures) if (f.get()) acks++;\
\
        response->set_success(acks >= kW);\
        if (acks >= kW) return grpc::Status::OK;\
        return grpc::Status(grpc::StatusCode::UNAVAILABLE, "Failed to reach write quorum for delete");\
    \}\
\
    // ---------- Internal replication API (called by peer coordinators) ----------\
\
    grpc::Status ReplicatePut(grpc::ServerContext*, const kvstore::ReplicatePutRequest* request,\
                               kvstore::ReplicatePutResponse* response) override \{\
        storage_.Put(request->key(), request->value(), request->timestamp());\
        response->set_success(true); // ack means "processed", not "value changed"\
        return grpc::Status::OK;\
    \}\
\
    grpc::Status ReplicateGet(grpc::ServerContext*, const kvstore::ReplicateGetRequest* request,\
                               kvstore::ReplicateGetResponse* response) override \{\
        auto v = storage_.GetVersioned(request->key());\
        if (!v.has_value()) \{ response->set_found(false); return grpc::Status::OK; \}\
        response->set_found(true);\
        response->set_value(v->value);\
        response->set_timestamp(v->timestamp);\
        response->set_is_tombstone(v->is_tombstone);\
        return grpc::Status::OK;\
    \}\
\
    grpc::Status ReplicateDelete(grpc::ServerContext*, const kvstore::ReplicateDeleteRequest* request,\
                                  kvstore::ReplicateDeleteResponse* response) override \{\
        storage_.Delete(request->key(), request->timestamp());\
        response->set_success(true);\
        return grpc::Status::OK;\
    \}\
\
    // ---------- Debug API ----------\
\
    grpc::Status DebugOwner(grpc::ServerContext*, const kvstore::DebugOwnerRequest* request,\
                             kvstore::DebugOwnerResponse* response) override \{\
        response->set_owner_address(ring_.GetNode(request->key()));\
        return grpc::Status::OK;\
    \}\
\
    grpc::Status DebugPreferenceList(grpc::ServerContext*, const kvstore::DebugPreferenceListRequest* request,\
                                      kvstore::DebugPreferenceListResponse* response) override \{\
        for (auto& n : ring_.GetPreferenceList(request->key(), kN)) response->add_nodes(n);\
        return grpc::Status::OK;\
    \}\
\
    grpc::Status DebugLocalGet(grpc::ServerContext*, const kvstore::DebugLocalGetRequest* request,\
                                kvstore::DebugLocalGetResponse* response) override \{\
        auto v = storage_.GetVersioned(request->key());\
        if (!v.has_value()) \{ response->set_exists(false); return grpc::Status::OK; \}\
        response->set_exists(true);\
        response->set_is_tombstone(v->is_tombstone);\
        response->set_value(v->value);\
        response->set_timestamp(v->timestamp);\
        return grpc::Status::OK;\
    \}\
\
private:\
    bool SendReplicatePut(const std::string& node, const std::string& key,\
                           const std::string& value, uint64_t timestamp) \{\
        kvstore::ReplicatePutRequest req;\
        req.set_key(key); req.set_value(value); req.set_timestamp(timestamp);\
        kvstore::ReplicatePutResponse resp;\
        grpc::ClientContext ctx;\
        ctx.set_deadline(std::chrono::system_clock::now() + std::chrono::milliseconds(2000));\
        auto status = peer_stubs_.at(node)->ReplicatePut(&ctx, req, &resp);\
        return status.ok() && resp.success();\
    \}\
\
    StorageEngine storage_;\
    ConsistentHashRing ring_;\
    std::string self_address_;\
    std::unordered_map<std::string, std::unique_ptr<kvstore::KeyValueStore::Stub>> peer_stubs_;\
\};\
\
std::vector<std::string> ExtractNodes(const std::string& path) \{\
    std::vector<std::string> nodes;\
    std::ifstream file(path);\
    std::string line;\
    while (std::getline(file, line)) if (!line.empty()) nodes.push_back(line);\
    return nodes;\
\}\
\
void RunServer(const std::string& self_address, const std::string& cluster_config_file) \{\
    auto all_nodes = ExtractNodes(cluster_config_file);\
    KVServiceImpl service(self_address, all_nodes);\
\
    grpc::ServerBuilder builder;\
    builder.AddListeningPort(self_address, grpc::InsecureServerCredentials());\
    builder.RegisterService(&service);\
    server = builder.BuildAndStart();\
    std::cout << "Server listening on " << self_address << std::endl;\
\
    std::signal(SIGINT, SignalHandler);\
    std::signal(SIGTERM, SignalHandler);\
    while (!shutdown_requested.load())\
        std::this_thread::sleep_for(std::chrono::milliseconds(100));\
\
    std::cout << "Shutting down gracefully." << std::endl;\
    server->Shutdown();\
    server->Wait();\
\}\
\
int main(int argc, char** argv) \{\
    if (argc < 3) \{\
        std::cerr << "Usage: " << argv[0] << " <self_address> <cluster_config_file>" << std::endl;\
        return 1;\
    \}\
    RunServer(argv[1], argv[2]);\
    return 0;\
\}\
