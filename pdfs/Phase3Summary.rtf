            grpc::CreateChannel(a, grpc::InsecureChannelCredentials())));\
\
    auto StubFor = [&](const std::string& addr) -> kvstore::KeyValueStore::Stub* \{\
        for (size_t i = 0; i < addresses.size(); i++) if (addresses[i] == addr) return stubs[i].get();\
        return nullptr;\
    \};\
\
    std::string key = "fault_tolerance_key";\
    std::string value = "important_data";\
\
    // Discover which 3 nodes own this key\
    kvstore::DebugPreferenceListRequest preq; preq.set_key(key);\
    kvstore::DebugPreferenceListResponse presp;\
    \{ grpc::ClientContext ctx; stubs[0]->DebugPreferenceList(&ctx, preq, &presp); \}\
    std::vector<std::string> replicas(presp.nodes().begin(), presp.nodes().end());\
    assert(replicas.size() == 3);\
    std::cout << "Replicas for key: " << replicas[0] << ", " << replicas[1] << ", " << replicas[2] << std::endl;\
\
    // Write with all 3 replicas alive\
    \{\
        kvstore::PutRequest req; req.set_key(key); req.set_value(value);\
        kvstore::PutResponse resp;\
        grpc::ClientContext ctx;\
        auto status = stubs[0]->Put(&ctx, req, &resp);\
        assert(status.ok() && resp.success());\
    \}\
    std::cout << "[OK] Write succeeded with 3/3 replicas alive." << std::endl;\
\
    // Kill ONE replica\
    KillNode(replicas[0]);\
    std::vector<std::string> dead = \{replicas[0]\};\
\
    \{\
        auto coordinator = PickAlive(addresses, dead);\
        kvstore::GetRequest req; req.set_key(key);\
        kvstore::GetResponse resp;\
        grpc::ClientContext ctx;\
        auto status = StubFor(coordinator)->Get(&ctx, req, &resp);\
        assert(status.ok() && resp.found() && resp.value() == value);\
    \}\
    std::cout << "[OK] Read succeeded with 2/3 replicas alive (quorum of 2 met)." << std::endl;\
\
    // Kill a SECOND replica \'97 now only 1 of 3 remains\
    KillNode(replicas[1]);\
    dead.push_back(replicas[1]);\
\
    \{\
        auto coordinator = PickAlive(addresses, dead);\
        kvstore::GetRequest req; req.set_key(key);\
        kvstore::GetResponse resp;\
        grpc::ClientContext ctx;\
        auto status = StubFor(coordinator)->Get(&ctx, req, &resp);\
        assert(!status.ok()); // cannot reach a quorum of 2 with only 1 replica alive\
    \}\
    std::cout << "[OK] Read correctly failed with only 1/3 replicas alive "\
                 "(quorum of 2 NOT met \'97 this is expected, not a bug)." << std::endl;\
\
    std::cout << "\\nRestart the cluster now: ./scripts/stop_cluster.sh && ./scripts/start_cluster.sh\\n";\
    return 0;\
\}\
\pard\pardeftab720\sa240\partightenfactor0

