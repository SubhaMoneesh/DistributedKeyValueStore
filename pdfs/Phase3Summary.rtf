\f5\fs26 \cf0 #pragma once\
#include <map>\
#include <vector>\
#include <string>\
#include <shared_mutex>\
\
class ConsistentHashRing \{\
public:\
    std::string GetNode(const std::string& key) const;\
    std::vector<std::string> GetPreferenceList(const std::string& key, int n) const;\
    void AddNode(const std::string& node_address);\
    void RemoveNode(const std::string& node_address);\
    std::vector<std::string> GetAllPhysicalNodes() const;\
    static uint64_t Hash(const std::string& input);\
\
    explicit ConsistentHashRing(int virtual_nodes_per_physical = 150);\
\
private:\
    int virtual_nodes_per_physical_;\
    std::map<std::uint64_t, std::string> ring_;\
    mutable std::shared_mutex mutex_;\
\};\
\pard\pardeftab720\sa240\partightenfactor0

\f3\b\fs24 \cf0 src/hash_ring.cpp
\f2\b0  (add this method; keep everything else from Phase 2 unchanged):\
\pard\pardeftab720\partightenfactor0

\f5\fs26 \cf0 std::vector<std::string> ConsistentHashRing::GetPreferenceList(const std::string& key, int n) const \{\
    std::shared_lock lock(mutex_);\
    std::vector<std::string> result;\
    if (ring_.empty()) return result;\
\
    std::set<std::string> seen;\
    uint64_t h = Hash(key);\
    auto it = ring_.lower_bound(h);\
    size_t visited = 0;\
\
    // Walk clockwise, collecting distinct physical nodes, wrapping around the ring.\
    while (result.size() < static_cast<size_t>(n) && visited < ring_.size()) \{\
        if (it == ring_.end()) it = ring_.begin();\
        if (seen.insert(it->second).second) \{\
            result.push_back(it->second);\
        \}\
        ++it;\
        ++visited;\
    \}\
    return result;\
\}\
\pard\pardeftab720\sa240\partightenfactor0
\cf0 GetPreferenceList(key, 1)[0]
\f2\fs24  will always equal 
\f5\fs26 GetNode(key)
\f2\fs24  \'97 same walk, just stopping at 1 distinct node. This is a good consistency check to put in a test.\
\pard\pardeftab720\partightenfactor0
