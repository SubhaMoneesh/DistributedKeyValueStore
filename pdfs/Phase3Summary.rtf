\f3\b\fs36 \cf0 Step 3: Test the preference list in isolation\
\pard\pardeftab720\sa240\partightenfactor0

\f2\b0\fs24 \cf0 Add to 
\f3\b tests/hash_ring_test.cpp
\f2\b0 :\
\pard\pardeftab720\partightenfactor0

\f5\fs26 \cf0 void test_preference_list() \{\
    ConsistentHashRing ring;\
    for (int i = 1; i <= 6; i++) ring.AddNode("node" + std::to_string(i));\
\
    // Correct size and all distinct\
    auto pref = ring.GetPreferenceList("some_key", 3);\
    assert(pref.size() == 3);\
    assert(pref[0] != pref[1] && pref[1] != pref[2] && pref[0] != pref[2]);\
\
    // Deterministic\
    assert(pref == ring.GetPreferenceList("some_key", 3));\
\
    // First entry always matches GetNode (single-owner lookup)\
    assert(pref[0] == ring.GetNode("some_key"));\
\
    // Bulk check: always 3 distinct nodes, even for keys that hash near\
    // ring wraparound points \'97 proves the wraparound logic is correct.\
    for (int i = 0; i < 50000; i++) \{\
        auto p = ring.GetPreferenceList("bulk_key_" + std::to_string(i), 3);\
        assert(p.size() == 3);\
        assert(p[0] != p[1] && p[1] != p[2] && p[0] != p[2]);\
    \}\
\
    std::cout << "[OK] Preference lists are correctly sized, distinct, deterministic.\\n";\
\}\
