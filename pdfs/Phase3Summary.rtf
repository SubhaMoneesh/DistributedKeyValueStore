\
void test_basic() \{\
    StorageEngine engine;\
    assert(engine.GetVersioned("missing") == std::nullopt);\
\
    assert(engine.Put("k", "v1", 100) == true);\
    auto v = engine.GetVersioned("k");\
    assert(v.has_value() && v->value == "v1" && v->timestamp == 100 && !v->is_tombstone);\
\
    std::cout << "[OK] Basic put/get works.\\n";\
\}\
\
void test_last_write_wins() \{\
    StorageEngine engine;\
    assert(engine.Put("k", "newer", 200) == true);\
\
    // A write with an OLDER timestamp must be rejected\
    assert(engine.Put("k", "older", 100) == false);\
    auto v = engine.GetVersioned("k");\
    assert(v->value == "newer" && v->timestamp == 200);\
\
    // A write with a NEWER timestamp must win\
    assert(engine.Put("k", "newest", 300) == true);\
    v = engine.GetVersioned("k");\
    assert(v->value == "newest" && v->timestamp == 300);\
\
    std::cout << "[OK] Last-write-wins ordering enforced correctly.\\n";\
\}\
\
void test_tombstones() \{\
    StorageEngine engine;\
    engine.Put("k", "v1", 100);\
    assert(engine.Delete("k", 200) == true);\
\
    auto v = engine.GetVersioned("k");\
    assert(v.has_value());          // key is NOT gone \'97 it's a tombstone\
    assert(v->is_tombstone == true);\
\
    // A stale put after the delete must not resurrect the value\
    assert(engine.Put("k", "zombie", 150) == false);\
    v = engine.GetVersioned("k");\
    assert(v->is_tombstone == true);\
\
    // A newer put after the delete correctly overwrites the tombstone\
    assert(engine.Put("k", "reborn", 300) == true);\
    v = engine.GetVersioned("k");\
    assert(!v->is_tombstone && v->value == "reborn");\
\
    std::cout << "[OK] Tombstones prevent resurrection of deleted data.\\n";\
\}\
\
void test_concurrency() \{\
    StorageEngine engine;\
    std::vector<std::thread> threads;\
    for (int t = 0; t < 8; t++) \{\
        threads.emplace_back([&engine, t]() \{\
            for (int i = 0; i < 500; i++) \{\
                std::string key = "shared_" + std::to_string(i % 5);\
                uint64_t ts = static_cast<uint64_t>(t) * 100000 + i;\
                engine.Put(key, "v" + std::to_string(t), ts);\
                engine.GetVersioned(key);\
            \}\
        \});\
    \}\
    for (auto& t : threads) t.join();\
    std::cout << "[OK] Concurrent versioned writes complete without crashes.\\n";\
\}\
\
int main() \{\
    test_basic();\
    test_last_write_wins();\
    test_tombstones();\
    test_concurrency();\
    std::cout << "All storage engine tests passed.\\n";\
\}\
